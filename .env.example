# Copy to .env before running docker compose.

# Deployment settings. The data directory and listen address already have
# suitable container defaults.
# TDRIVE_DATA_DIR=/data
# TDRIVE_LISTEN=:8080

# Externally reachable origin, e.g. https://drive.example.com
# TDRIVE_BASE_URL=

# The first WebUI account. Also the WebDAV username and password.
TDRIVE_ADMIN_USER=admin
TDRIVE_ADMIN_PASSWORD=change-this-please

# Telegram API credentials and performance settings are configured in the
# WebUI under Settings after the administrator account is created.
# Optional initial defaults (the WebUI can change and persist these values).
# TDRIVE_TG_UPLOAD_PART_SIZE=512KiB
# TDRIVE_TG_RATE_LIMIT=100ms
# TDRIVE_UPLOAD_CONCURRENCY=2
# TDRIVE_DOWNLOAD_CONCURRENCY=2

# Optional: choose the host directory to mount read-only for VPS-local uploads.
# After login, set the container-side path (/vps) in WebUI Settings > Runtime;
# no TDRIVE_LOCAL_DIR variable is needed.
# TDRIVE_LOCAL_PATH=/srv/repository
