# Copy to .env before running docker compose.

# The first WebUI account. Also the WebDAV username and password.
TDRIVE_ADMIN_USER=admin
TDRIVE_ADMIN_PASSWORD=change-this-please

# From https://my.telegram.org/apps. Optional: the setup wizard can collect
# them instead.
TDRIVE_TG_APP_ID=
TDRIVE_TG_APP_HASH=

# Externally reachable origin, e.g. https://drive.example.com
TDRIVE_BASE_URL=

# --- Tuning. The defaults are what the performance targets were set against.

# Where a file is split into separate Telegram objects. The ceiling is
# 2000MiB, which is 4000 upload parts of 512KiB — the largest single object
# the protocol can express. 1900MiB leaves headroom.
# TDRIVE_SEGMENT_SIZE=1900MiB

# MTProto connections to a datacenter. The main lever on throughput.
# TDRIVE_TG_POOL_SIZE=8

# Concurrent 512KiB part uploads within one segment.
# TDRIVE_UPLOAD_THREADS=8

# Concurrent 1MiB chunk reads while streaming.
# TDRIVE_STREAM_CONCURRENCY=6
